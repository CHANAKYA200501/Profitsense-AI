# Production Environment Variables for Render
# Add these in Render Dashboard → Service Settings → Environment Variables

# === Database Configuration ===
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/profitsense
# Example: postgresql://postgres:mypassword@dpg-xyz.render.com:5432/profitsense

# === Redis Configuration ===
REDIS_URL=redis://[user]:[password]@[host]:[port]
# Example: redis://:mypassword@red-xyz.render.com:6379

# === Application Settings ===
ENVIRONMENT=production
PORT=8000
PYTHON_VERSION=3.10

# === CORS Configuration ===
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com,https://app.your-domain.com

# === Security (ADD IN RENDER DASHBOARD - DON'T COMMIT) ===
JWT_SECRET_KEY=your_super_secret_jwt_key_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Third-party Integrations ===
# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Broker APIs (if using)
# BROKER_API_KEY=your_broker_api_key
# BROKER_API_SECRET=your_broker_api_secret

# === Logging & Monitoring ===
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project_id

# === Feature Flags ===
ENABLE_PAPER_TRADING=true
ENABLE_TELEGRAM_ALERTS=true
ENABLE_ML_MODELS=true

# === Cache Configuration ===
CACHE_TTL_SECONDS=3600
REDIS_MAX_CONNECTIONS=10

# === Database Connection Pool ===
DATABASE_POOL_SIZE=5
DATABASE_POOL_RECYCLE=3600

# === API Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# === File Upload Settings ===
MAX_FILE_UPLOAD_MB=10
KYC_UPLOAD_PATH=/tmp/kyc_uploads

# === Model Settings ===
ML_MODEL_PATH=/app/ml_models
VECTOR_STORE_PATH=/app/vector_store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === APScheduler Configuration (for scheduled tasks) ===
SCHEDULER_JOB_STORE_TYPE=sqlalchemy
SCHEDULER_JOB_STORE_URL=${DATABASE_URL}
SCHEDULER_EXECUTORS_DEFAULT_TYPE=threadpool
SCHEDULER_EXECUTORS_DEFAULT_MAX_WORKERS=3

# === Celery Configuration ===
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=30m

# === Optional: Email Configuration (if needed) ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ADMIN_EMAIL=admin@your-domain.com

# === Optional: AWS/S3 Configuration ===
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
